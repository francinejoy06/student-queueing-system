<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | QueueDesk</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="<%= currentUser.role === 'admin' ? '/admin/users' : currentUser.role === 'student' ? '/student/dashboard' : '/staff/dashboard' %>">
        <span class="brand-mark">Q</span>
        <span>QueueDesk<small>STUDENT SERVICES</small></span>
      </a>
      <div class="nav-label">WORKSPACE</div>
      <% if (currentUser.role === 'admin') { %>
        <a class="nav-link <%= active === 'users' ? 'active' : '' %>" href="/admin/users"><span class="nav-icon">◎</span> User management</a>
        <a class="nav-link <%= active === 'offices' ? 'active' : '' %>" href="/admin/offices"><span class="nav-icon">▣</span> Offices</a>
        <a class="nav-link" href="/staff/dashboard"><span class="nav-icon">▦</span> Staff dashboard</a>
      <% } else if (currentUser.role === 'student') { %>
        <a class="nav-link <%= active === 'student' ? 'active' : '' %>" href="/student/dashboard"><span class="nav-icon">≡</span> My queue</a>
      <% } else { %>
        <a class="nav-link <%= active === 'dashboard' ? 'active' : '' %>" href="/staff/dashboard"><span class="nav-icon">▦</span> Dashboard</a>
        <a class="nav-link <%= active === 'queue' ? 'active' : '' %>" href="/staff/queue"><span class="nav-icon">≡</span> Queue</a>
      <% } %>
      <div class="sidebar-bottom">
        <div class="user-chip">
          <span class="avatar"><%= currentUser.full_name.charAt(0).toUpperCase() %></span>
          <span class="user-meta"><strong><%= currentUser.full_name %></strong><small><%= currentUser.role %></small></span>
        </div>
        <form method="POST" action="/logout">
          <button class="logout-button" type="submit"><span>↪</span> Sign out</button>
        </form>
      </div>
    </aside>
    <main class="main-content">
      <header class="topbar">
        <div><span class="eyebrow">STUDENT QUEUEING SYSTEM</span><h1><%= title %></h1></div>
        <span class="date-chip"><span class="live-dot"></span> Queue is live</span>
      </header>