<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Queueing System</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="login-page">
  <div class="login-art">
    <a class="brand brand-light" href="/signup"><span class="brand-mark">Q</span><span>QueueDesk<small>STUDENT SERVICES</small></span></a>
    <div class="art-copy">
      <span class="eyebrow light">YOUR CAMPUS, IN GOOD ORDER</span>
      <h1>Your time<br><em>matters.</em></h1>
      <p>Create an account to join campus service queues and spend less time waiting.</p>
      <div class="art-visual">
        <div class="ticket-preview"><span class="ticket-kicker">YOUR QUEUE PASS</span><strong>A-025</strong><span class="ticket-line"></span><span class="ticket-footer">REGISTRAR <i>● READY</i></span></div>
        <div class="floating-note"><span class="live-dot"></span> Your place, made clear</div>
      </div>
    </div>
    <div class="art-caption">One organized queue, a better campus experience.</div>
  </div>
  <main class="login-panel">
    <section class="login-card">
      <span class="eyebrow">STUDENT ACCOUNT</span>
      <h2>Create your account</h2>
      <p class="muted">Sign up to access campus queue services.</p>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <form method="POST" action="/signup" class="form-stack">
        <label for="full_name">Full name</label>
        <input id="full_name" name="full_name" type="text" autocomplete="name" maxlength="100" placeholder="Your full name" value="<%= fullName %>" required>
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="100" placeholder="you@school.edu" value="<%= email %>" required>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" placeholder="8 or more characters" required>
        <label for="confirm_password">Confirm password</label>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="8" maxlength="72" placeholder="Enter your password again" required>
        <button class="button primary wide" type="submit">Create account <span>→</span></button>
      </form>
      <p class="login-help">Already have an account? <a class="text-link" href="/login">Sign in</a></p>
    </section>
    <footer class="login-footer">© <%= new Date().getFullYear() %> QueueDesk · Campus service operations</footer>
  </main>
</body>
</html>
