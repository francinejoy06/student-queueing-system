<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Queueing System</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="login-page">
  <div class="login-art">
    <a class="brand brand-light" href="/login"><span class="brand-mark">Q</span><span>QueueDesk<small>STUDENT SERVICES</small></span></a>
    <div class="art-copy">
      <span class="eyebrow light">STUDENT SERVICES, SIMPLIFIED</span>
      <h1>Less waiting.<br><em>More doing.</em></h1>
      <p>A calmer, clearer way to manage campus service queues.</p>
      <div class="art-visual">
        <div class="ticket-preview"><span class="ticket-kicker">NOW SERVING</span><strong>A-024</strong><span class="ticket-line"></span><span class="ticket-footer">REGISTRAR <i>● LIVE</i></span></div>
        <div class="floating-note"><span class="live-dot"></span> Queue moving smoothly</div>
      </div>
    </div>
    <div class="art-caption">One organized queue, a better campus experience.</div>
  </div>
  <main class="login-panel">
    <section class="login-card">
      <span class="eyebrow">CAMPUS PORTAL</span>
      <h2>Welcome back</h2>
      <p class="muted">Sign in with your campus account to continue.</p>
      <% if (typeof success !== 'undefined' && success) { %><div class="alert success" role="status"><%= success %></div><% } %>
      <% if (typeof error !== 'undefined' && error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <form method="POST" action="/login" class="form-stack">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="username" placeholder="you@school.edu" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
        <div class="label-row"><label for="password">Password</label></div>
        <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required>
        <button class="button primary wide" type="submit">Sign in <span>→</span></button>
      </form>
      <p class="login-help">New to the queue? <a class="text-link" href="/signup">Create a student account</a></p>
    </section>
    <footer class="login-footer">© <%= new Date().getFullYear() %> QueueDesk · Campus service operations</footer>
  </main>
</body>
</html>
