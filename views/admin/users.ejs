
<%- include('../partials/header', {
  title: 'User management',
  active: 'users',
  currentUser
}) %>

<% if (message) { %>
  <div class="alert success" role="status"><%= message %></div>
<% } %>

<% if (error) { %>
  <div class="alert error" role="alert"><%= error %></div>
<% } %>

<%
  const activeOffices = offices.filter(function (office) {
    return office.is_active === undefined ||
      Number(office.is_active) === 1;
  });
%>

<section class="admin-intro">
  <div>
    <h2>Manage system access</h2>
    <p class="muted">
      View accounts and manage office assignments for staff.
      User names and roles cannot be changed here.
    </p>
  </div>

  <span class="admin-count">
    <strong><%= users.length %></strong> accounts
  </span>
</section>

<section class="panel">
  <div class="panel-heading">
    <div>
      <h2>System users</h2>
      <p class="muted">Accounts with access to QueueDesk</p>
    </div>
  </div>

  <% if (users.length) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>USER</th>
            <th>EMAIL</th>
            <th>ROLE</th>
            <th>OFFICE</th>
            <th>JOINED</th>
            <th>ACTIONS</th>
          </tr>
        </thead>

        <tbody>
          <% users.forEach(function (user) { %>
            <%
              const assignedOffice = offices.find(function (office) {
                return Number(office.id) === Number(user.office_id);
              });
            %>

            <tr>
              <td>
                <div class="person-cell">
                  <span class="avatar small">
                    <%= user.full_name.charAt(0).toUpperCase() %>
                  </span>
                  <strong><%= user.full_name %></strong>
                </div>
              </td>

              <td><%= user.email %></td>

              <td>
                <span class="role-pill <%= user.role %>">
                  <%= user.role %>
                </span>
              </td>

              <td>
                <% if (user.role === 'staff') { %>
                  <%= assignedOffice
                    ? assignedOffice.name
                    : 'Unassigned' %>
                <% } else { %>
                  <span class="muted">Not applicable</span>
                <% } %>
              </td>

              <td>
                <%= new Date(user.created_at).toLocaleDateString() %>
              </td>

              <td class="row-actions">
                <% if (user.role === 'staff') { %>
                  <details>
                    <summary class="small-action">
                      Assign office
                    </summary>

                    <form
                      method="POST"
                      action="/admin/users/<%= user.id %>/edit"
                      style="display:flex;gap:8px;margin-top:8px"
                    >
                      <select
                        name="office_id"
                        aria-label="Staff office"
                      >
                        <option value="">Unassigned</option>

                        <% activeOffices.forEach(function (office) { %>
                          <option
                            value="<%= office.id %>"
                            <%= Number(user.office_id) === Number(office.id)
                              ? 'selected'
                              : '' %>
                          >
                            <%= office.name %>
                          </option>
                        <% }); %>
                      </select>

                      <button class="small-action" type="submit">
                        Save
                      </button>
                    </form>
                  </details>
                <% } %>

                <% if (Number(user.id) !== Number(currentUser.id)) { %>
                  <form
                    method="POST"
                    action="/admin/users/<%= user.id %>/delete"
                    onsubmit="return confirm('Delete this user account?')"
                  >
                    <button
                      class="small-action danger-text"
                      type="submit"
                    >
                      Delete
                    </button>
                  </form>
                <% } else { %>
                  <span class="you-label">You</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <strong>No user accounts</strong>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
